{
    "name": "solara",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "packageManager": "pnpm@11.12.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "vite build",
        "preview": "vite build && wrangler pages dev dist --ip 127.0.0.1 --port 8787",
        "typecheck": "tsc --noEmit",
        "check:css": "node scripts/check-css-budget.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.3.3",
        "typescript": "^7.0.2",
        "vite": "^5.4.0",
        "wrangler": "^3.0.0"
    }
}
