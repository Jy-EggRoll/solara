# Solara 环境变量示例。复制为 .env（或 .dev.vars）并按需填写；真实文件已被 .gitignore 忽略。
# Docker 自托管：docker-entrypoint.sh 会据此生成 .dev.vars 供 wrangler 使用。
# Cloudflare Pages：请在 Pages 后台 Settings → Environment variables 配置同名变量。

# 访问密码（登录页使用；留空则通常表示不启用鉴权，详见 functions/_middleware.ts）
PASSWORD=change-me

# 上游音乐 API 基地址（可替换为自建/国内节点）
API_BASE_URL=https://music-api.gdstudio.xyz/api.php

# 界面语言（可选）：留空为中文，设为 ENG 切换英文（详见 functions/_middleware.ts）
language=
